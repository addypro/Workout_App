output_intents = {intent['voice_command']: {**intent, "database_mapping": []} for intent in intents_config}
assigned_exercises = set()

# Same target group map and miscellaneous fallback
output_intents["Miscellaneous"] = {
    "voice_command": "Miscellaneous",
    "aliases": ["Other"],
    "default_exercise": None,
    "keywords": [],
