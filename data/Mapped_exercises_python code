    "clarification_prompt": "I'm not sure.",
    "database_mapping": []
}

for exercise in exercises:
    name = exercise['name']
    match_found = False
    
    # 1. Keyword Matching
    for intent in intents_config:
        if any(ex.lower() in name.lower() for ex in intent['excludes']):
            continue
        if any(kw.lower() in name.lower() for kw in intent['keywords']):
            output_intents[intent['voice_command']]["database_mapping"].append(name)
            assigned_exercises.add(name)
            match_found = True
            break 
            
    # 2. Fallback: Muscle Group
    if not match_found:
        target = exercise.get('muscles', {}).get('targetGroup')
        if target and target in target_group_map:
            mapped_intent_key = target_group_map[target]
            if mapped_intent_key in intent_lookup:
                final_key = intent_lookup[mapped_intent_key]
            else:
                final_key = mapped_intent_key
            
            if final_key in output_intents:
                output_intents[final_key]["database_mapping"].append(name)
                assigned_exercises.add(name)
                match_found = True
    
    # 3. Fallback: Miscellaneous
    if not match_found:
        output_intents["Miscellaneous"]["database_mapping"].append(name)
        assigned_exercises.add(name)

