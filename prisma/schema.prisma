// Prisma Schema for Workout App (Mobile)
// Configured for Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CONSUMER
  COACH
}

enum SourceType {
  PDF
  CSV
  EXCEL
  IMAGE
}

enum ProgramStatus {
  PARSING
  MAPPING
  READY
  ERROR
}

enum MembershipTier {
  FREE
  BASIC
  PREMIUM
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
  FLEXIBILITY
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  password      String    // Hashed password (use bcrypt!)
  role          UserRole  @default(CONSUMER)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  programs      Program[]
  profile       UserProfile?
  workoutLogs   WorkoutLog[]
  activities    Activity[]
  bookings      WorkoutSession[]
  memberships   Membership[]
  programRatings ProgramRating[]
  createdChallenges Challenge[] @relation("ChallengeCreator")
  challengeParticipants ChallengeParticipant[]

  @@map("users")
}

model Program {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  sourceFileUri String      // Local file URI or Supabase storage path
  sourceType    SourceType

  status        ProgramStatus @default(PARSING)
  parsedData    Json?        // Native PostgreSQL JSONB

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  versions      ProgramVersion[]
  installLinks  InstallLink[]
  workoutLogs   WorkoutLog[]
  sessions      WorkoutSession[]
  ratings       ProgramRating[]

  @@map("programs")
}

model ProgramVersion {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String   @db.Uuid
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  version     Int      @default(1)
  data        Json     // Native PostgreSQL JSONB

  createdAt   DateTime @default(now())

  workouts    Workout[]

  @@map("program_versions")
}

model Workout {
  id          String   @id @default(uuid()) @db.Uuid
  versionId   String   @db.Uuid
  version     ProgramVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  week        Int
  day         Int
  name        String?

  exercises   Exercise[]
  order       Int      @default(0)

  @@map("workouts")
}

model Exercise {
  id          String   @id @default(uuid()) @db.Uuid
  workoutId   String   @db.Uuid
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  name        String
  originalName String?
  mappedExerciseId String? @db.Uuid
  sets        Int
  reps        String?
  weight      String?
  restSeconds Int?
  notes       String?

  order       Int      @default(0)

  @@map("exercises")
}

model ExerciseDatabase {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  aliases     Json     @default("[]") // PostgreSQL JSONB array
  category    String?
  equipment   Json     @default("[]") // PostgreSQL JSONB array
  muscleGroups Json?   // Primary and secondary muscle groups
  videoUrl    String?
  instructions String? // Exercise instructions
  createdAt   DateTime @default(now())

  @@map("exercise_database")
}

model InstallLink {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String   @db.Uuid
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  slug        String   @unique
  exportUri   String   // Supabase storage path or local URI
  installCount Int     @default(0)

  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("install_links")
}

model UserProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fitnessGoal   FitnessGoal?
  fitnessLevel  FitnessLevel?
  age           Int?
  height        Float?   // in cm
  weight        Float?   // in kg
  bio           String?
  location      String?

  preferredWorkoutTime String?
  workoutDaysPerWeek Int? @default(3)
  preferredEquipment Json @default("[]") // PostgreSQL JSONB array

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_profiles")
}

model WorkoutLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId   String?  @db.Uuid
  program     Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  workoutId   String?  @db.Uuid
  week        Int?
  day         Int?

  completedAt DateTime @default(now())
  duration    Int?     // in minutes
  notes       String?
  rating      Int?     // 1-5 workout difficulty/satisfaction

  exercises   WorkoutLogExercise[]

  @@map("workout_logs")
}

model WorkoutLogExercise {
  id          String   @id @default(uuid()) @db.Uuid
  workoutLogId String  @db.Uuid
  workoutLog  WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  exerciseName String
  sets        Int
  reps        String?
  weight      String?
  completed   Boolean  @default(false)
  notes       String?
  rpe         Int?     // Rate of Perceived Exertion (1-10)

  order       Int      @default(0)

  @@map("workout_log_exercises")
}

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  steps       Int?
  calories    Int?
  heartRate   Int?
  distance    Float?   // in km
  activeMinutes Int?

  source      String?  // e.g., "apple_health", "google_fit"
  sourceId    String?  // External ID from source

  createdAt   DateTime @default(now())

  @@map("activities")
}

model WorkoutSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId   String?  @db.Uuid
  program     Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  scheduledAt DateTime
  duration    Int      @default(60) // in minutes
  status      String   @default("scheduled") // scheduled, completed, skipped, cancelled
  notes       String?

  reminderSent Boolean @default(false)
  reminderSentAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workout_sessions")
}

model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier        MembershipTier @default(FREE)

  startDate   DateTime @default(now())
  endDate     DateTime?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("memberships")
}

model ProgramRating {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId   String   @db.Uuid
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  rating      Int      // 1-5
  review      String?
  isPublic    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, programId])
  @@map("program_ratings")
}

model Challenge {
  id          String   @id @default(uuid()) @db.Uuid
  createdById String   @db.Uuid
  createdBy   User     @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Cascade)

  name        String
  description String?
  startDate   DateTime
  endDate     DateTime

  goal        String?
  rules       Json?    // PostgreSQL JSONB

  isActive    Boolean  @default(true)
  isPublic    Boolean  @default(true)

  participants ChallengeParticipant[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("challenges")
}

model ChallengeParticipant {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  challengeId String   @db.Uuid
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  progress    Json?    // PostgreSQL JSONB
  completed   Boolean  @default(false)
  completedAt DateTime?

  joinedAt    DateTime @default(now())

  @@unique([userId, challengeId])
  @@map("challenge_participants")
}
